{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/explore/writing.html",
      "destination": "/explore/writing",
      "permanent": true
    },
    {
      "source": "/explore/image.html",
      "destination": "/explore/image",
      "permanent": true
    },
    {
      "source": "/explore/coding.html",
      "destination": "/explore/coding",
      "permanent": true
    },
    {
      "source": "/explore/video.html",
      "destination": "/explore/video",
      "permanent": true
    },
    {
      "source": "/explore/productivity.html",
      "destination": "/explore/productivity",
      "permanent": true
    }
  ]
}
